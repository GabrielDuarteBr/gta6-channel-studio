{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.84", "--headless", "--isolated"]
    },
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp@0.3.0", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${STUDIO_DB_URL:-postgresql://studio:defina-STUDIO_DB_URL@127.0.0.1:55432/studio}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.6.0"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_MCP_PAT:-}" }
    }
  }
}
