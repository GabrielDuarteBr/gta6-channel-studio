// Radar Neon — schema do banco.
// Fase 0: núcleo (dono do painel, configurações, auditoria, jobs, custos, cota, OAuth).
// As tabelas de pauta, parceiros, biblioteca, produção etc. entram nas fases seguintes.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Único usuário do painel (o dono do canal). Login com senha + TOTP.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  /// Segredo TOTP cifrado com AES-256-GCM (TOKEN_ENCRYPTION_KEY).
  totpSecretEnc      String
  /// Hashes argon2 dos códigos de recuperação ainda não usados.
  recoveryCodeHashes String[]
  /// Último time step TOTP aceito (impede reutilizar o mesmo código).
  lastTotpStep       Int?
  /// Incrementado ao recriar o dono: invalida todas as sessões abertas.
  sessionVersion     Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Configurações editáveis no painel (chave → JSON validado com zod em @studio/shared).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

enum AuditOutcome {
  OK
  DENIED
  ERROR
}

/// Trilha de auditoria: toda ação relevante do dono, dos agentes e do sistema.
model AuditLog {
  id      String       @id @default(cuid())
  at      DateTime     @default(now())
  /// "owner" | "agent:<nome>" | "system" | "scheduler"
  actor   String
  /// ex.: "auth.login", "settings.update", "policy.violation"
  action  String
  target  String?
  outcome AuditOutcome @default(OK)
  details Json?

  @@index([at])
  @@index([action, at])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  INTERRUPTED
  CANCELLED
}

/// Espelho dos jobs do BullMQ. O id é o jobId determinístico (idempotência).
model JobRun {
  id         String    @id
  queue      String
  name       String
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  payload    Json?
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([queue, status])
  @@index([status, updatedAt])
}

/// Custos de API (Claude, TTS, imagem) por tarefa. Base do teto diário/mensal.
model CostLedger {
  id               String   @id @default(cuid())
  at               DateTime @default(now())
  /// AAAA-MM-DD em America/Sao_Paulo
  dayKey           String
  /// "anthropic" | "tts" | "image"
  provider         String
  model            String?
  /// ex.: "agent:roteirista"
  task             String
  jobRunId         String?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  /// Caracteres de voz (TTS) cobráveis desta linha (cota grátis mensal do Google)
  characters       Int?
  /// Caracteres de TTS, número de imagens etc.
  units            Float?
  costUsd          Decimal  @db.Decimal(12, 6)
  simulated        Boolean  @default(false)
  /// Vídeo a que este gasto pertence (custo real por vídeo, Fase 3)
  productionId     String?

  @@index([dayKey])
  @@index([provider, dayKey])
  @@index([productionId])
}

/// Uso da cota da YouTube Data API por balde. A cota zera à meia-noite do Pacífico.
model QuotaLedger {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// AAAA-MM-DD em America/Los_Angeles
  pacificDay String
  /// "search.list" | "videos.insert" | "default"
  bucket     String
  method     String
  units      Int
  simulated  Boolean  @default(false)
  jobRunId   String?

  @@index([pacificDay, bucket])
}

/// Tokens OAuth (Google/YouTube), sempre cifrados.
model OAuthToken {
  id              String    @id @default(cuid())
  provider        String
  accountLabel    String
  scopes          String[]
  accessTokenEnc  String?
  refreshTokenEnc String
  expiresAt       DateTime?
  /// "ok" | "invalid" | "revoked"
  status          String    @default("ok")
  lastCheckedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, accountLabel])
}

// ============================================================================
// Fase 1 — Pesquisa (fontes, notícias coletadas e histórias agrupadas)
// ============================================================================

enum SourceKind {
  /// Feed RSS/Atom (ou página com autodescoberta de feed)
  RSS
  /// Página HTML sem feed: extrai links de artigos por padrão de URL
  PAGE
  /// Canal do YouTube (só metadados, via Data API)
  YOUTUBE_CHANNEL
  /// Busca no YouTube (só metadados; usa o balde caro search.list)
  YOUTUBE_SEARCH
}

enum SourceTier {
  /// Rockstar, Take-Two: prioridade máxima
  OFFICIAL
  /// Imprensa de games consolidada
  PRESS
  /// Sites de fãs, criadores e comunidade (rumores aparecem aqui)
  COMMUNITY
}

model Source {
  id            String     @id @default(cuid())
  /// Chave estável das fontes padrão (null nas fontes criadas pelo dono)
  key           String?    @unique
  name          String
  kind          SourceKind
  tier          SourceTier
  /// URL do feed/página, @handle do canal ou termo de busca
  url           String
  /// Regex de links de artigo (PAGE) e outros ajustes por tipo
  config        Json?
  language      String     @default("en")
  enabled       Boolean    @default(true)
  builtIn       Boolean    @default(false)
  /// Feed descoberto automaticamente, canal resolvido etc.
  resolved      Json?
  etag          String?
  lastModified  String?
  lastFetchedAt DateTime?
  lastOkAt      DateTime?
  /// "ok" | "erro" | "sem chave" | "sem novidades"
  lastStatus    String?
  lastError     String?
  lastItemCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         NewsItem[]
}

model NewsItem {
  id              String    @id @default(cuid())
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// URL canônica (sem utm etc.) — deduplicação entre fontes
  url             String    @unique
  /// Domínio registrável (independência de fontes para rumores)
  domain          String
  title           String
  summary         String?
  author          String?
  publishedAt     DateTime?
  fetchedAt       DateTime  @default(now())
  normalizedTitle String
  /// Sinais de engajamento (YouTube: views, likes...)
  metrics         Json?
  /// Bandeiras de política detectadas no texto (vazamento, trapaça, spoiler...)
  flags           Json?
  isRumor         Boolean   @default(false)
  storyId         String?
  story           Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([storyId])
  @@index([publishedAt])
}

enum StoryStatus {
  NEW
  QUEUED_LONG
  QUEUED_SHORT
  QUEUED_COMPILATION
  DISMISSED
}

model Story {
  id                 String       @id @default(cuid())
  title              String
  /// Título/resumo em PT-BR (triagem do Claude Haiku ou o próprio título)
  titlePt            String?
  summaryPt          String?
  firstSeenAt        DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  score              Float        @default(0)
  scoreBreakdown     Json?
  itemCount          Int          @default(0)
  independentSources Int          @default(0)
  officialCount      Int          @default(0)
  isRumor            Boolean      @default(false)
  /// Bandeiras de política agregadas (vazamento, spoiler...)
  flags              Json?
  /// "oficial" | "reportagem" | "rumor" | "vazamento" | "opinião" | "guia"
  kind               String?
  newsworthiness     Float?
  triagedAt          DateTime?
  status             StoryStatus  @default(NEW)
  statusChangedAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  items              NewsItem[]
  productions        Production[]
  assets             Asset[]

  @@index([score])
  @@index([lastSeenAt])
  @@index([status])
}

/// Bíblia do personagem (Fase 2). Cada edição cria uma versão nova; a ativa é a maior.
model CharacterBible {
  id        String   @id @default(cuid())
  version   Int      @unique
  content   Json
  note      String?
  createdBy String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Fase 3 — Biblioteca (mídia com manifesto de direitos) e Produção de vídeos
// ---------------------------------------------------------------------------

enum AssetKind {
  IMAGE
  AUDIO
  VIDEO
}

/// De onde a mídia veio (regra 1: nada do YouTube; tudo com manifesto).
enum AssetOrigin {
  /// Imprensa oficial (Rockstar Newswire, kit de imprensa da Take-Two)
  OFFICIAL_PRESS
  /// Arquivo enviado por parceiro com permissão registrada (Fase 4)
  PARTNER
  /// Gerada pelo nosso provedor de imagem (Google Imagen/Gemini)
  IMAGE_PROVIDER
  /// Enviada pelo dono (arte própria, foto própria)
  OWNER_UPLOAD
  /// Material do próprio canal (segmentos já publicados)
  CHANNEL_OWN
}

enum RightsStatus {
  ACTIVE
  REVOKED
}

/// Mídia da Biblioteca. O arquivo fica no S3 (SeaweedFS); só entra em render com manifesto ativo.
model Asset {
  id          String            @id @default(cuid())
  kind        AssetKind         @default(IMAGE)
  origin      AssetOrigin
  title       String
  description String?
  tags        String[]          @default([])
  /// Chave no S3 (library/<sha256>.<ext>)
  storageKey  String            @unique
  /// Mesmo arquivo enviado duas vezes vira o mesmo asset
  sha256      String            @unique
  mime        String
  width       Int?
  height      Int?
  bytes       Int
  storyId     String?
  story       Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  /// Vídeo: duração em segundos
  durationSec Float?
  /// Nome do arquivo como chegou (envio do dono ou link do parceiro)
  originalName String?
  /// Arquivo de parceiro (origem PARTNER)
  partnerId   String?
  partner     Partner?          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// Análise do vídeo (transcrição, trechos de fala, música, trocas de cena)
  analysis    Json?
  analysisStatus AnalysisStatus?
  analysisError  String?
  /// O dono ouviu e marcou "sem música/filme/TV de terceiros": o áudio original pode ir inteiro.
  /// Sem a marca, o clipe leva só a voz do parceiro (o resto fica mudo).
  audioCleared Boolean          @default(false)
  /// "owner" | "agent:diretor-arte" ...
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  manifest    RightsManifest?
  usages      ProductionAsset[]
  reactSources Production[]     @relation("ReactSource")

  @@index([origin])
  @@index([storyId])
  @@index([partnerId])
}

enum AnalysisStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

/// Manifesto de direitos: de onde veio, sob que licença, com que prova e restrições.
model RightsManifest {
  id            String       @id @default(cuid())
  assetId       String       @unique
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  origin        AssetOrigin
  /// Página de origem (comunicado oficial, termos do provedor)
  sourceUrl     String?
  /// Licença/base de uso em texto (ex.: "Imprensa oficial — uso editorial")
  license       String
  /// Crédito exibido no vídeo/descrição
  credit        String?
  /// Prova (link do comunicado, descrição do e-mail do parceiro...)
  proof         String?
  /// { editorialOnly, allowThumbnail, mustCredit }
  restrictions  Json?
  /// Provedor/modelo (IMAGE_PROVIDER)
  provider      String?
  /// Prompt usado (IMAGE_PROVIDER)
  prompt        String?
  status        RightsStatus @default(ACTIVE)
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  /// Permissão do parceiro que cobre este arquivo (origem PARTNER)
  permissionId  String?
  permission    PartnerPermission? @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([permissionId])
}

enum ProductionFormat {
  LONG
  SHORT
}

enum ProductionKind {
  /// Notícia da Pauta (Fase 3)
  NEWS
  /// Short de react com clipe de parceiro (Fase 4)
  REACT
}

enum ProductionStatus {
  /// Esperando o dono clicar em "Produzir"
  DRAFT
  QUEUED
  SCRIPTING
  ART
  VOICE
  RENDERING
  REVIEWING
  /// Aprovado pelo Revisor visual; aguarda o dono (publicação na Fase 5)
  READY
  /// Revisor reprovou depois de todas as voltas, ou política bloqueou
  NEEDS_ATTENTION
  FAILED
  CANCELED
}

/// Um vídeo: notícia (longo 16:9 ou Short 9:16, a partir de uma história da Pauta) ou
/// Short de react (clipe de parceiro com comentário do Zeca).
model Production {
  id           String            @id @default(cuid())
  kind         ProductionKind    @default(NEWS)
  storyId      String?
  story        Story?            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// React: parceiro e arquivo de origem
  partnerId    String?
  partner      Partner?          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  sourceAssetId String?
  sourceAsset  Asset?            @relation("ReactSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  format       ProductionFormat
  status       ProductionStatus  @default(DRAFT)
  /// Detalhe da etapa atual (ex.: "imagem 3 de 6")
  step         String?
  title        String?
  /// Roteiro validado (zod, pacote @studio/production)
  script       Json?
  /// Cenas com mídia escolhida, trechos de voz e tempos
  plan         Json?
  /// Vereditos do Revisor visual (uma entrada por volta)
  review       Json?
  reviewRound  Int               @default(0)
  /// { video, thumbnails[], thumbnail, durationSec, narrationRatio }
  outputs      Json?
  /// Tempo, CPU e memória de cada render
  renderReport Json?
  error        String?
  createdBy    String
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assets       ProductionAsset[]

  @@index([status])
  @@index([storyId])
  @@index([partnerId])
  @@index([createdAt])
}

/// Que mídia cada vídeo usou (revogação de direitos lista os vídeos afetados).
model ProductionAsset {
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  /// "cena" | "thumbnail"
  role         String
  scene        Int        @default(0)

  @@id([productionId, assetId, role, scene])
  @@index([assetId])
}

/// Cotação do dólar (PTAX de venda do Banco Central), uma linha por dia de cotação.
model FxRate {
  id        String   @id @default(cuid())
  /// AAAA-MM-DD do boletim do Banco Central
  day       String   @unique
  /// Reais por dólar
  rate      Decimal  @db.Decimal(10, 4)
  /// "bcb-ptax"
  source    String
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Parceiros (Fase 4): candidatos, permissões e condições. O sistema nunca envia mensagens.
// ---------------------------------------------------------------------------

enum PartnerStage {
  /// Achado pelo Caçador ou colado pelo dono; sem permissão
  CANDIDATE
  /// O dono disse que mandou a mensagem (o sistema só rascunha)
  CONTACTED
  /// Tem permissão registrada (ver o status de cada permissão)
  PARTNER
  /// O dono descartou
  DISMISSED
}

/// Criador de conteúdo de GTA 6: candidato ou parceiro.
model Partner {
  id           String       @id @default(cuid())
  name         String
  /// Canal do YouTube (só metadados)
  channelId    String?      @unique
  handle       String?
  channelUrl   String
  description  String?
  country      String?
  subscribers  Int?
  videoCount   Int?
  stage        PartnerStage @default(CANDIDATE)
  /// Evidências: frases vagas encontradas ("cortes liberados" = candidato, nunca permissão)
  evidence     Json?
  /// Nota do Caçador (0 a 1) e o motivo
  fitScore     Float?
  fitReason    String?
  /// Rascunho da mensagem pedindo permissão (o dono copia e envia por conta própria)
  draftMessage String?
  /// "agent:cacador" | "owner"
  discoveredBy String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  permissions  PartnerPermission[]
  assets       Asset[]
  productions  Production[]
  imports      PartnerImport[]

  @@index([stage])
}

enum PermissionType {
  /// Cortes em Shorts de react com comentário do Zeca
  REACT_CLIPS
}

enum ProofKind {
  EMAIL
  DIRECT_MESSAGE
  CONTRACT
  OTHER
}

enum PermissionStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Permissão registrada pelo dono: tipo, prova, condições e status (regra 2).
model PartnerPermission {
  id            String           @id @default(cuid())
  partnerId     String
  partner       Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  type          PermissionType
  proofKind     ProofKind
  /// O que o criador escreveu, quando e onde
  proof         String
  /// Print ou e-mail salvo no S3
  proofFileKey  String?
  grantedAt     DateTime
  expiresAt     DateTime?
  /// { credit, link, hashtag, monetization, maxClipSec, notes }
  conditions    Json
  status        PermissionStatus @default(ACTIVE)
  revokedAt     DateTime?
  revokedReason String?
  createdBy     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  manifests     RightsManifest[]
  imports       PartnerImport[]

  @@index([partnerId])
  @@index([status])
}

enum ImportStatus {
  QUEUED
  DOWNLOADING
  PROCESSING
  DONE
  FAILED
}

/// Importação de arquivos do parceiro: link do Dropbox/Drive (nunca YouTube) ou envio no painel.
model PartnerImport {
  id           String            @id @default(cuid())
  partnerId    String
  partner      Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  permissionId String
  permission   PartnerPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  /// "dropbox" | "gdrive" | "upload"
  source       String
  /// Link compartilhado (Dropbox ou Google Drive)
  url          String?
  /// Envio pelo painel: chave temporária no S3 (incoming/...)
  incomingKey  String?
  originalName String?
  title        String?
  status       ImportStatus      @default(QUEUED)
  step         String?
  error        String?
  /// Mídias criadas na Biblioteca
  assetIds     String[]          @default([])
  createdBy    String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([partnerId])
  @@index([status])
}

