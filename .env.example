# =====================================================================
# Radar Neon — variáveis de ambiente
# Copie para .env com `make setup` (gera as senhas automaticamente).
# O .env NUNCA vai para o Git. Na VPS ele fica com permissão 600.
# =====================================================================

# ----- Perfil e modos ------------------------------------------------
# notebook: render 720p, 1 render por vez, limites menores
# vps:      render 1080p, limites de produção
APP_PROFILE=notebook
LOG_LEVEL=info
# Modo simulado: TTS/imagem falsos e upload que não envia nada ao YouTube.
# Valor inicial; depois é controlado pelo painel (Configurações).
SIMULATION_MODE=true
TZ=America/Sao_Paulo

# ----- Banco de dados (Postgres) ------------------------------------
POSTGRES_USER=studio
POSTGRES_DB=studio
POSTGRES_PASSWORD=__GERAR__

# ----- Filas (Redis) -------------------------------------------------
REDIS_PASSWORD=__GERAR__

# ----- Armazenamento S3 local (SeaweedFS) ---------------------------
S3_BUCKET=studio
S3_REGION=us-east-1
S3_ACCESS_KEY=__GERAR__
S3_SECRET_KEY=__GERAR__

# ----- Painel ---------------------------------------------------------
# URL pública do painel. No notebook: http://localhost:3000
AUTH_URL=http://localhost:3000
# Segredo das sessões do painel (gerado).
AUTH_SECRET=__GERAR__
# Chave AES-256 (base64, 32 bytes) para cifrar tokens OAuth e o segredo TOTP.
TOKEN_ENCRYPTION_KEY=__GERAR__

# ----- APIs (preenchidas nas fases seguintes) ------------------------
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TTS_API_KEY=
IMAGE_API_KEY=

# ----- Alertas (Fase 8) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Produção (VPS, Fase 8) ----------------------------------------
DOMAIN=
ACME_EMAIL=
GHCR_OWNER=gabrielduartebr
IMAGE_TAG=latest

# ----- Opcional: build atrás de proxy corporativo --------------------
# Certificado de CA extra usado só durante o build das imagens. Coloque o arquivo
# em infra/docker/extra-ca.local.pem (ignorado pelo Git) e descomente:
# EXTRA_CA_CERT=./docker/extra-ca.local.pem
