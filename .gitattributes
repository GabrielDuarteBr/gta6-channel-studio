# Fim de linha LF em todo o repositório (WSL 2, containers Linux e VPS).
* text=auto eol=lf

*.sh text eol=lf
Makefile text eol=lf
*.py text eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.ogg binary
*.riv binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary

# Scripts do Windows: o cmd.exe exige CRLF; guardados como estão (sem normalizar)
*.bat -text
